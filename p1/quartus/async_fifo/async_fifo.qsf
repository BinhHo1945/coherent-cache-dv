# Quartus settings for async_fifo (P1). Synthesis-only evaluation, no pin locations.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY async_fifo
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/async_fifo.sv
set_global_assignment -name SDC_FILE async_fifo.sdc
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
# Hides the $fatal parameter checks that Quartus Standard/Lite cannot parse.
set_global_assignment -name VERILOG_MACRO "QUARTUS_SYNTH=1"

# Top-level parameters (spec section 3 defaults)
set_parameter -name DEPTH 16
set_parameter -name DATA_WIDTH 32

# Virtual pins on all top-level ports so I/O does not limit timing
set_instance_assignment -name VIRTUAL_PIN ON -to wrst_n
set_instance_assignment -name VIRTUAL_PIN ON -to rrst_n
set_instance_assignment -name VIRTUAL_PIN ON -to wr_en
set_instance_assignment -name VIRTUAL_PIN ON -to wr_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to full
set_instance_assignment -name VIRTUAL_PIN ON -to overflow
set_instance_assignment -name VIRTUAL_PIN ON -to rd_en
set_instance_assignment -name VIRTUAL_PIN ON -to rd_data[*]
set_instance_assignment -name VIRTUAL_PIN ON -to empty
set_instance_assignment -name VIRTUAL_PIN ON -to underflow

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"